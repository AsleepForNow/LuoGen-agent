# Copy to turnserver.conf; use the same long random secret as TURN_SECRET.
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_LONG_RANDOM_SHARED_SECRET
realm=your-domain.example
# For public cloud NAT, set external-ip=PUBLIC_IP/PRIVATE_IP.
# external-ip=203.0.113.10/10.0.0.10
min-port=49160
max-port=49200
no-cli
no-multicast-peers
no-loopback-peers
# Production TLS requires a valid cert and key for turns: support:
# cert=/etc/letsencrypt/live/your-domain.example/fullchain.pem
# pkey=/etc/letsencrypt/live/your-domain.example/privkey.pem
# log-file=stdout
